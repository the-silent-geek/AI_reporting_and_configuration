# Copy to backend/.env (git-ignored). DB host/name/role passwords come from db/.env.

# Long random string, YOUR OWN (each person's API signs its own tokens).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15

# Empty = in-process broker (dev only: no AI worker, progress only via /api/dev/progress).
# Shared RabbitMQ on the host PC (ask the host for the password):
#   amqp://studio:<password>@100.96.34.125:5672/
# Tests must use the separate vhost:  .../studio_test
RABBITMQ_URL=

# Where original uploads are kept. The AI worker must be able to read the file path.
# NOTE: stored as a file:// path on the machine running the API (see docs/TEAM_SETUP.md,
# "Uploads and the AI worker"). Empty = backend/storage.
STORAGE_DIR=
MAX_UPLOAD_MB=50

CORS_ORIGINS=http://localhost:5173
# true when served over HTTPS
COOKIE_SECURE=false
# true enables POST /api/dev/progress (fake worker). Never in production.
DEV_ENDPOINTS=true
