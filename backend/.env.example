# Copy to backend/.env (git-ignored). DB host/name/role passwords come from db/.env.

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15

# Empty = in-process broker (dev only, no AI worker). Real: amqp://user:pass@localhost:5672/
RABBITMQ_URL=

# Where original uploads are kept (the AI worker must be able to read this path)
STORAGE_DIR=
MAX_UPLOAD_MB=50

CORS_ORIGINS=http://localhost:5173
# true when served over HTTPS
COOKIE_SECURE=false
# true enables POST /api/dev/progress (fake worker). Never in production.
DEV_ENDPOINTS=true

# Smart Assistance (Groq). Empty key = the assistant answers 503.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
