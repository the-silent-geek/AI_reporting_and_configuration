# Copy to db/.env (git-ignored). Used by the BACKEND only.
# The real values live in db/.env on the host PC (generated by db/build.ps1).
# Get them from the host through a private channel, never through git or chat groups.

# Host PC's Tailscale IP (or leave localhost if the DB runs on your own machine)
DB_HOST=100.96.34.125
DB_PORT=5432
DB_NAME=reporting_studio

# One login per product schema + one for auth. Copy the values from the host's db/.env.
IAM_APP_PASSWORD=
ERP_APP_PASSWORD=
AML_APP_PASSWORD=
LENDING_APP_PASSWORD=
