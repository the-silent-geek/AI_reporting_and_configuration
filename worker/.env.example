# Copy to worker/.env (git-ignored). Unset values fall back to backend/.env, then db/.env.
#   backend/.env -> RABBITMQ_URL, STORAGE_DIR (must be the same as the API's)
#   db/.env      -> DB_HOST, DB_PORT, DB_NAME, ERP_APP_PASSWORD, AML_APP_PASSWORD, LENDING_APP_PASSWORD

# Jobs processed at once (= RabbitMQ prefetch). OCR and BGE are CPU-heavy: keep it low.
WORKER_CONCURRENCY=1
# Temporary failures (DB down, OCR time budget) are retried with backoff 5s, 10s, ...
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=5

# Local semantic matching. Empty = BGE layer off.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BGE_ACCEPT=0.80
BGE_MARGIN=0.03

# Groq, only for ambiguous fields. Empty key = off (ambiguous fields are flagged for review).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20

# PDF: pages with fewer embedded characters than this are treated as scanned.
PDF_MIN_TEXT_CHARS=20
OCR_DPI=200
OCR_LANG=en
OCR_REVIEW_BELOW=0.80
OCR_TIMEOUT_SECONDS=600
